# TypeScript build artifacts emitted into source dirs by accidental `tsc --build` runs.
# Vite resolves vite.config.js BEFORE vite.config.ts, so a stale .js silently shadows
# the .ts and live config edits stop taking effect — see commit 781248e6 lessons.
frontend/vite.config.js
frontend/vite.config.d.ts

# Editor scratch (Obsidian workspace state, Playwright MCP page/console traces)
.obsidian/
.playwright-mcp/

# Screenshots dropped at the repo root — developer scratch, not assets.
# `/` anchors to repo root only, leaving frontend/public/*.png tracked.
/*.png
.superpowers/

# Design-review tooling scratch (critique snapshots, live-preview state, caches).
# No slash in these patterns, so each matches at any depth.
.impeccable/
.impeccable-live.json
.impeccable-live/
impeccable-live.client.ts

frontend/src/lib/impeccable/ImpeccableLiveRoot.svelte
frontend/src/lib/impeccable/__runtime.js
# Path-anchored: unanchored, `[0-9a-f]*/` also ignores `backend/`, `docs/`,
# `e2e/` and `frontend/`.
frontend/src/lib/impeccable/[0-9a-f]*/

# Per-developer compose overrides — host port remaps and the like, layered on
# with an explicit second `-f`. Machine-specific by definition, and a tracked
# one is worse than none: it sits among the twelve real compose files reading
# as supported, while remapping the host ports the documented workflows use
# (backend tests reach PostgreSQL on 5433 — see docker-compose.dev.yml).
# Prefer the env-var knobs the tracked files already expose (`REDIS_HOST_PORT`)
# and add another when one is missing.
docker/docker-compose.local.yml
docker/docker-compose.*.local.yml
