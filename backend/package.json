{
  "name": "backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Integration-test workspace. Contains only tests + shared test utilities that exercise the assembled app (the runtime routes/services live in @dashboard/*). Ships nothing to production — it is not built into or installed in the production Docker image.",
  "exports": {},
  "scripts": {
    "dev": "tsx watch ../packages/server/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dashboard/ai": "*",
    "@dashboard/contracts": "*",
    "@dashboard/core": "*",
    "@dashboard/foundation": "*",
    "@dashboard/infrastructure": "*",
    "@dashboard/observability": "*",
    "@dashboard/operations": "*",
    "@dashboard/security": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino-pretty": "^13.0.0",
    "redis": "^6.2.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
