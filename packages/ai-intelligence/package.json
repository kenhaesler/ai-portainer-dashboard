{
  "name": "@dashboard/ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LLM, anomaly detection, monitoring orchestration, and AI insights",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "indexes:incidents": "tsx scripts/create-incident-signature-indexes.ts",
    "dump:titles": "tsx scripts/dump-historical-titles.ts",
    "backfill:signatures": "tsx scripts/backfill-incident-signatures.ts"
  },
  "dependencies": {
    "@dashboard/contracts": "*",
    "@dashboard/core": "*",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "p-limit": "^7.3.0",
    "socket.io": "^4.8.1",
    "undici": "^8.3.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
