{
  "name": "@dashboard/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Composition root — wires all domain packages and starts the Fastify server",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dashboard/contracts": "*",
    "@dashboard/foundation": "*",
    "@dashboard/core": "*",
    "@dashboard/ai": "*",
    "@dashboard/observability": "*",
    "@dashboard/security": "*",
    "@dashboard/operations": "*",
    "@dashboard/infrastructure": "*",
    "fastify": "^5.12.0",
    "p-limit": "^7.3.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "redis": "^6.2.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
